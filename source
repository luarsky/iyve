do
	local drags = {}
	function stopDragging(dragObject)
		if not drags[dragObject] then return end
		for _,v in drags[dragObject] do
			v = killConnection(v)
		end
		drags[dragObject] = nil
	end
	function startDragging(dragObject:Frame,dragDetector:TextButton)
		if drags[dragObject] then return end
		drags[dragObject] = {}
		local function onMouseButton1Down()
			local dragging
			local function onInputChanged(input:InputObject)
				if not dragObject.Parent then stopDragging(dragObject) return end
				if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
				local currentPosition,deltaPosition = dragObject.Position,input.Delta
				dragObject.Position = UDim2.new(currentPosition.X.Scale,currentPosition.X.Offset+deltaPosition.X,currentPosition.Y.Scale,currentPosition.Y.Offset+deltaPosition.Y)
			end
			dragging = UserInputService.InputChanged:Connect(onInputChanged)
			table.insert(drags[dragObject],dragging)
			local function onMouseButton1Up()
				local draggingIndex = table.find(drags[dragObject],dragging)
				if draggingIndex then table.remove(drags[dragObject],draggingIndex) end
				dragging = killConnection(dragging)
			end
			table.insert(drags[dragObject],dragDetector.MouseButton1Up:Once(onMouseButton1Up))
		end
		table.insert(drags[dragObject],dragDetector.MouseButton1Down:Connect(onMouseButton1Down))
	end
end

