do
	local connections,UpDown = {},{}
	local platform:BasePart?
	table.insert(COMMANDS,{
		['float / platform'] = {
			description = 'Spawns a platform beneath you causing you to float',
			execute = function()
				if connections.floating or ownerHumanoid:IsDead() then return end
				local startPivot = ownerCharacter:GetPivot()*CFrame.new(0,-.1,0)
				platform = createInstance('Part',{Parent=workspace,Name='Platform',Transparency=.5,CFrame=startPivot,Size=Vector3.new(2,.2,1.5)})
				local y = startPivot.Position.Y
				local function onHeartbeat()
					if ownerHumanoid:IsDead() or not platform.Parent then execute('unfloat') return end
					local newPivot = ownerCharacter:GetPivot()
					local newPosition = newPivot.Position
					y = (platform.Position-newPosition).Magnitude > ownerHumanoid.JumpPower/5 and (ownerCharacter:GetPivot()*CFrame.new(0,-.1,0)).Position.Y or y
					platform.CFrame = CFrame.new(newPosition.X,y,newPosition.Z)*newPivot.Rotation
				end
				connections.floating = RunService.Heartbeat:Connect(onHeartbeat)
				local function onInputBegan(input:InputObject,gameProcessedEvent)
					local key = input.KeyCode.Name
					if gameProcessedEvent or (key ~= 'E' and key ~= 'Q') then return end
					if key == 'E' and UpDown.Q then
						UpDown.Q = killThread(UpDown.Q)
					elseif key == 'Q' and UpDown.E then
						UpDown.E = killThread(UpDown.E)
					end
					--[[UpDown[key] = task.spawn(function()
						repeat
							wait()
							y += key == 'E' and .1 or -.1
						until not UserInputService:IsKeyDown(key) or not UpDown[key]
					end)]]
					local pressing = coroutine.create(function()
						repeat
							wait()
							y += key == 'E' and .25 or -.25
						until not UserInputService:IsKeyDown(key) or not UpDown[key]
					end)
					UpDown[key] = pressing
					coroutine.resume(pressing)
				end
				connections.UpDown = UserInputService.InputBegan:Connect(onInputBegan)
				notify('Float','Started floating (Q = down & E = up)')
			end
		}
	})
	table.insert(COMMANDS,{
		['unfloat / noplatform'] = {
			description = 'Removes the platform',
			execute = function()
				if not connections.floating then return end
				for _,v in UpDown do
					v = killThread(v)
				end
				table.clear(UpDown)
				for _,v in connections do
					v = killConnection(v)
				end
				table.clear(connections)
				if platform.Parent then platform:Destroy() end
				if ownerHumanoid:IsDead() then return end
				notify('Float','Stopped floating')
			end
		}
	})
end

