do
	local SPEED,MIN_SPEED,MAX_SPEED = 50,50,150
	local GHOSTING = false
	local noclipping
	table.insert(COMMANDS,{
		['noclip [speed] [ghosting]'] = {
			description = `Go through objects (min speed - {MIN_SPEED}, max - {MAX_SPEED}; default ghosting - {GHOSTING})`,
			execute = function(text:string)
				if noclipping or ownerHumanoid:IsDead() then return end
				local arguments = text:split(' ')
				SPEED = getNumberArgument(arguments[1],MIN_SPEED,MAX_SPEED) or SPEED
				local newGhosting = getBooleanArgument(arguments[2])
				GHOSTING = if newGhosting ~= nil then newGhosting else GHOSTING
				stopLoopCommands()
				local lastPivot = ownerCharacter:GetPivot()
				local function onHeartbeat(deltaTime)
					if ownerHumanoid:IsDead() then return end
					local moveDirection = getMoveDirection()
					if moveDirection == Vector3.zero then lastPivot = ownerCharacter:GetPivot() return end
					ownerCharacter.Velocity = Vector3.new(0,ownerCharacter.Velocity.Y,0)
					local newPivot = ownerCharacter:GetPivot()+moveDirection*deltaTime*SPEED
					ownerCharacter:PivotTo(GHOSTING and lastPivot:Lerp(newPivot,deltaTime) or newPivot)
					lastPivot = newPivot
				end
				noclipping = RunService.Heartbeat:Connect(onHeartbeat)
			end
		}
	})
	table.insert(COMMANDS,{
		['unnoclip / clip'] = {
			description = 'Disables noclip',
			execute = function()
				if not noclipping then return end
				noclipping = killConnection(noclipping)
			end
		}
	})
end

