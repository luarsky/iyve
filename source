local function createInstance(class,properties)
	local instance = Instance.new(class,properties.Parent)
	for i,v in properties do
		if i ~= 'Parent' then instance[i] = v end
	end
	return instance
end

local function killThread(thread)
	local threadStatus = coroutine.status(thread)
	if threadStatus == 'running' or threadStatus == 'suspended' then --[[task.cancel(thread)]] coroutine.close(thread) end
end

local function killConnection(connection)
	if connection then connection:Disconnect() end
end

