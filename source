local function getCommandNames(text:string?)
	return text:gsub(' %b[]',''):gsub(' %b()',''):split(' / ')
end

local function getNumberArgument(text,low,high)
	local number = tonumber(text)
	return number and math.clamp(number,low,high)
end

local function getBooleanArgument(text:string?)
	text = text and text:lower()
	return text == 'true'
end

local function getStringArgument(text:string?,availables)
	text = text and text:lower()
	return table.find(availables,text) and text or availables[1]
end

local function getPlayerArgument(text:string?):{Player?}
	text = text and text:lower()
	local allPlayers = (inStudio and workspace:FindFirstChild('FakePlayers')) and workspace.FakePlayers:GetChildren() or Players:GetPlayers() -- Halo, server & clients or team create when? 
	if text == 'all' then
		return allPlayers
	elseif text == 'others' then
		local others = {}
		for _,v:Player? in allPlayers do
			if v ~= owner then table.insert(others,v) end
		end
		return others
	elseif text == 'me' then
		return {owner}
	elseif text:find('#') == 1 and tonumber(text:sub(2,-1)) then
		local randomPlayers = {}
		for _=1,math.clamp(tonumber(text:sub(2,-1)),1,#allPlayers) do
			local randomPlayer:Player? = allPlayers[math.random(1,#allPlayers)]
			table.insert(randomPlayers,randomPlayer)
			table.remove(allPlayers,table.find(allPlayers,randomPlayer))
		end
		return randomPlayers
	elseif text == 'random' then
		local ownerIndex = table.find(allPlayers,owner)
		if ownerIndex then table.remove(allPlayers,ownerIndex) end
		return {allPlayers[math.random(1,#allPlayers)]}
	elseif text:find('rad') == 1 and tonumber(text:sub(4,-1)) then
		local radius = tonumber(text:sub(4,-1))
		local inRadius = {}
		for _,v:Player? in allPlayers do
			local character = v.Character
			if v ~= owner and character and (character:GetPivot().Position-ownerCharacter:GetPivot().Position).Magnitude <= radius then table.insert(inRadius,v) end
		end
		return inRadius
	elseif text == 'nearest' or text == 'farthest' then
		local distances = {}
		for _,v:Player? in allPlayers do
			local character = v.Character
			if v ~= owner and character then table.insert(distances,{v,(character:GetPivot().Position-ownerCharacter:GetPivot().Position).Magnitude}) end
		end
		table.sort(distances,function(distance1,distance2)
			return text == 'nearest' and distance1[2] < distance2[2] or distance1[2] > distance2[2]
		end)
		return #distances > 0 and {distances[1][1]} or {}
	elseif text == 'alive' or text == 'dead' then
		local aliveORdead = {}
		for _,v:Player? in allPlayers do
			local humanoid = getHumanoid(v)
			if v ~= owner and humanoid and (text == 'dead' and humanoid:IsDead() or not humanoid:IsDead()) then table.insert(aliveORdead,v) end
		end
		return aliveORdead
	elseif text == 'cursor' then
		local cursorWorldPosition = mouse.Hit.Position
		local nearestDistance,nearestPlayer = math.huge,nil
		for _,v:Player? in allPlayers do
			local character = v.Character
			local distance = character and (character:GetPivot().Position-cursorWorldPosition).Magnitude
			if not distance or distance > nearestDistance then continue end
			nearestPlayer = v
			nearestDistance = distance
		end
		return {nearestPlayer}
	elseif text and text ~= '' then
		local found = {}
		for _,v:Player? in allPlayers do
			if v ~= owner and v.Name:lower():find(text) == 1 then table.insert(found,v) end
		end
		return found
	end
	return {}
end

local COMMANDS = {}
local cmdHistory,historyCount = {},0
local cmdTweenSpeed = 1

local function execute(text:string,viaTerminal)
	local textData = text:split(' ')
	local argumentsText = ''
	local code
	for _,command in COMMANDS do
		for name,data in command do
			for _,v in getCommandNames(name) do
				if v ~= textData[1] then continue end
				code = data.execute 
				argumentsText = text:gsub(`{v}{text:match(`{v} `) and ' ' or ''}`,'')
				break 
			end
		end
	end
	if not code then return end
	if viaTerminal then
		table.insert(cmdHistory,text)
		if #cmdHistory > 30 then
			table.remove(cmdHistory,1)
		end
		if historyCount ~= 0 then
			local nextCount = historyCount+1
			historyCount = nextCount <= #cmdHistory and nextCount or 0
		end
	end
	code(argumentsText)
end

