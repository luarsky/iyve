do
	local textSize = 17
	local label:TextLabel = createInstance('TextLabel',{Parent=playerHovers,AnchorPoint=Vector2.xAxis,Size=UDim2.fromOffset(0,textSize),BackgroundTransparency=1,Text='',TextColor3=Color3.fromRGB(255,255,255),TextSize=textSize,Font='Roboto',Visible=false})
	createInstance('UIStroke',{Parent=label,Thickness=1.5})
	local connection
	local function getLabelSize()
		return UDim2.fromOffset(TextService:GetTextSize(label.Text,label.TextSize,label.Font,Vector2.new(math.huge,textSize)).X+5,textSize+1.5)
	end
	local function hideLabel()
		label.Visible = false
		label.Text = ''
		label.Size = getLabelSize()
	end
	table.insert(COMMANDS,{
		['hovername'] = {
			description = 'Shows a players username when your mouse is hovered over them',
			execute = function()
				if connection then return end
				local function onHeartbeat()
					local originCFrame = mouse.Origin
					local ray = workspace:Raycast(originCFrame.Position,originCFrame.LookVector.Unit*10000,{FilterDescendantsInstances={ownerCharacter},FilterType='Exclude'})
					local player = Players:GetPlayerFromCharacter(ray and ray.Instance.Parent)
					if player then
						label.Text = player.Name
						label.Size = getLabelSize()
						label.Position = UDim2.fromOffset(mouse.X-5,mouse.Y+10)
						label.Visible = true
					elseif label.Visible then
						hideLabel()
					end
				end
				connection = RunService.Heartbeat:Connect(onHeartbeat)
			end
		}
	})
	table.insert(COMMANDS,{
		['unhovername / nohovername'] = {
			description = 'Turns off hovername',
			execute = function()
				if not connection then return end
				connection = killConnection(connection)
				hideLabel()
			end
		}
	})
end

table.insert(COMMANDS,{
	['tools'] = {
		description = 'Copies tools from ReplicatedStorage',
		execute = function()
			for _,v in ReplicatedStorage:GetDescendants() do
				if v:IsA('Tool') then v:Clone().Parent = ownerBackpack end
			end
		end
	}
})

do
	local function removeTool(tool:Tool?)
		if tool:IsA('Tool') then tool:Destroy() end
	end
	table.insert(COMMANDS,{
		['notools / removetools / deletetools'] = {
			description = 'Removes tools from character and backpack',
			execute = function()
				if ownerCharacter.Parent then
					for _,v in ownerCharacter:GetChildren() do
						removeTool(v)
					end
				end
				for _,v in ownerBackpack:GetChildren() do
					removeTool(v)
				end
			end
		}
	})
	table.insert(COMMANDS,{
		['deleteselectedtool / dst'] = {
			description = 'Removes any currently selected tool',
			execute = function()
				local tool = ownerCharacter.Parent and ownerCharacter:FindFirstChildOfClass('Tool')
				if tool then removeTool(tool) end
			end
		}
	})
end

do
	local function dropTool(tool:Tool?)
		if not tool:IsA('Tool') then return end
		tool.Parent = ownerCharacter
		wait()
		tool.Parent = workspace
	end
	table.insert(COMMANDS,{
		['droptools (CLIENT)'] = {
			description = 'Drops your tools',
			execute = function()
				for _,v in ownerBackpack:GetChildren() do
					dropTool(v)
				end
				if ownerCharacter.Parent then
					for _,v in ownerCharacter:GetChildren() do
						dropTool(v)
					end
				end
			end
		}
	})
end

