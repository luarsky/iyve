do
	local LINE_REACH,MIN_LINE_REACH,MAX_LINE_REACH = 60,0,math.huge
	local BOX_REACH,MIN_BOX_REACH,MAX_BOX_REACH = 60,0,math.huge
	local tools = {}
	table.insert(COMMANDS,{
		['reach [num]'] = {
			description = 'Increases the hitbox of your held tool',
			execute = function(text:string)
				local tool = ownerCharacter.Parent and ownerCharacter:FindFirstChildOfClass('Tool')
				local handle:BasePart? = tool and tool:FindFirstChild('Handle')
				if not tool or not handle then return end
				LINE_REACH = getNumberArgument(text,MIN_LINE_REACH,MAX_LINE_REACH) or LINE_REACH
				if not tools[tool] then
					tools[tool] = handle.Size
				end
				handle.Size = tools[tool]+Vector3.zAxis*LINE_REACH
			end
		}
	})
	table.insert(COMMANDS,{
		['boxreach [num]'] = {
			description = 'Increases the hitbox of your held tool in a box shape',
			execute = function(text:string)
				local tool = ownerCharacter.Parent and ownerCharacter:FindFirstChildOfClass('Tool')
				local handle:BasePart? = tool and tool:FindFirstChild('Handle')
				if not tool or not handle then return end
				BOX_REACH = getNumberArgument(text,MIN_BOX_REACH,MAX_BOX_REACH) or BOX_REACH
				if not tools[tool] then
					tools[tool] = handle.Size
				end
				handle.Size = tools[tool]+Vector3.one*BOX_REACH
			end
		}
	})
	table.insert(COMMANDS,{
		['unreach / noreach'] = {
			description = 'Turns off reach',
			execute = function()
				for i,v in tools do
					if not i.Parent or not i:FindFirstChild('Handle') then continue end
					i.Handle.Size = v
				end
				table.clear(tools)
			end
		}
	})
end

do
	local loaded = false
	local loading:TextButton = createInstance('TextButton',{Parent=cmds,Name='Loading',Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.fromRGB(48,29,70),Text='',AutoButtonColor=false,ZIndex=100})
	local loadingIcon:CanvasGroup = createInstance('CanvasGroup',{Parent=loading,Name='Icon',AnchorPoint=Vector2.one/2,Position=UDim2.new(.5,0,.5,-10),Size=UDim2.fromOffset(105,55),BackgroundTransparency=1})
	local iconLabel:TextLabel = createInstance('TextLabel',{Parent=loadingIcon,Size=UDim2.new(0,50,1,0),BackgroundTransparency=1,Text='IY',TextColor3=Color3.fromRGB(16,159,0),TextScaled=true,Font='Pacifico'})
	local iconLabelStroke:UIStroke = createInstance('UIStroke',{Parent=iconLabel,Thickness=2.5,Transparency=.1})
	local iconLogo:ImageLabel = createInstance('ImageLabel',{Parent=loadingIcon,AnchorPoint=Vector2.xAxis,Position=UDim2.fromScale(1,0),Size=UDim2.new(0,75,1,0),BackgroundTransparency=1,Image=IMAGE_ASSET_IDS.logo})
	local credits:TextLabel = createInstance('TextLabel',{Parent=loading,Name='Credits',AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,20),Size=UDim2.new(1,0,0,20),BackgroundColor3=Color3.fromRGB(69,42,100),Text=table.concat(DEVS,' // '),TextSize=12,TextColor3=Color3.fromRGB(255,255,255),Font='Roboto'})
	TweenService:Create(loadingIcon,TweenInfo.new(.3,'Quart','Out'),{Size = UDim2.fromOffset(125,75)}):Play()
	TweenService:Create(credits,TweenInfo.new(.2,'Quart','Out'),{Position = UDim2.fromScale(.5,1)}):Play()
	
	local tip:Frame = createInstance('Frame',{Parent=tips,Name='Tip',Size=UDim2.fromOffset(200,96),BackgroundColor3=Color3.fromRGB(69,42,100),BackgroundTransparency=.1,Visible=false})
	local title:TextLabel = createInstance('TextLabel',{Parent=tip,Name='Title',Size=UDim2.new(1,0,0,20),BackgroundColor3=Color3.fromRGB(48,29,70),BackgroundTransparency=.1,TextColor3=Color3.fromRGB(255,255,255),TextSize=12,Font='Roboto'})
	local description:TextLabel = createInstance('TextLabel',{Parent=tip,Name='Description',AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,0,91),Size=UDim2.fromOffset(190,67),BackgroundTransparency=1,TextColor3=Color3.fromRGB(255,255,255),TextSize=13,TextWrapped=true,Font='Roboto'})
	
	local collapsing
	local function stopCollapsing()
		collapsing = killThread(collapsing)
	end
	local function collapseExpandTerminal(status,y:number?)
		TweenService:Create(terminal,TweenInfo.new(status and .2 or .5,'Quart','Out'),{Position=UDim2.new(1,0,1,status and 0 or y)}):Play()
	end
	
	do -- available commands
		local function onGetPropertyChangedSignal()
			cmdList.CanvasPosition = Vector2.zero
			local commandText = barTextBox.Text
			for _,v in cmdList:GetChildren() do
				if v:IsA('TextButton') then v.Visible = v.Name:match(commandText) and true or false end
			end
			if not barTextBox:IsFocused() then return end
			local isLastSpace = commandText:match('%s',commandText:len())
			collapseExpandTerminal(if isLastSpace then false else true,isLastSpace and 175)
		end
		barTextBox:GetPropertyChangedSignal('Text'):Connect(onGetPropertyChangedSignal)
	end
	
	for _,command in COMMANDS do -- load commands
		for name,data in command do
			local cmd:TextButton = createInstance('TextButton',{Parent=cmdList,Name=name,Size=UDim2.fromOffset(190,20),BackgroundTransparency=1,Text=name,TextColor3=Color3.fromRGB(255,255,255),TextSize=14,TextXAlignment='Left',Font='Roboto'})
			local function onMouseEnter()
				if not loaded then return end
				local noEmpty = name ~= ''
				tip.Visible = noEmpty
				if not noEmpty then return end
				title.Text = name
				description.Text = data.description
			end
			local function onMouseButton1Click()
				if not loaded then return end
				barTextBox.Text = `{getCommandNames(cmd.Text)[1]} `
				barTextBox:CaptureFocus()
			end
			cmd.MouseEnter:Connect(onMouseEnter)
			cmd.MouseButton1Click:Connect(onMouseButton1Click)
		end
	end
	
	do -- hover tips
		local mouseTipMoving
		local function getTipPlacement()
			local mouseY = mouse.Y
			return mouse.ViewSizeY-mouseY > 140 and Vector2.xAxis or Vector2.one,UDim2.fromOffset(mouse.X,mouseY)
		end
		local function onMouseEnter()
			if not loaded then return end
			local showAnchorPoint,showPosition = getTipPlacement()
			tip.AnchorPoint = showAnchorPoint
			tip.Position = showPosition
			tip.Visible = true
			local function onMove()
				local updateAnchorPoint,updatePosition = getTipPlacement()
				tip.AnchorPoint = updateAnchorPoint
				tip.Position = updatePosition
			end
			mouseTipMoving = mouse.Move:Connect(onMove)
		end
		local function onMouseLeave()
			if not loaded then return end
			tip.Visible = false
			if not mouseTipMoving then return end
			mouseTipMoving = killConnection(mouseTipMoving)
		end
		tipsHoverZone.MouseEnter:Connect(onMouseEnter)
		tipsHoverZone.MouseLeave:Connect(onMouseLeave)
	end
	
	do
		local commandText = ''
		do -- text box behaviour
			local function onFocusLost(enter)
				commandText = barTextBox.Text:lower()
				barTextBox.Text = ''
				collapseExpandTerminal(false,enter and 200 or 175)
				if enter then execute(commandText,true) end
			end
			barTextBox.FocusLost:Connect(onFocusLost)
		end
		do -- text box hotkeys
			local function onInputBegan(input:InputObject)
				if not loaded then return end
				local key = input.KeyCode.Name
				local isFocused = barTextBox:IsFocused()
				if key == 'Semicolon' and not isFocused then
					barTextBox:CaptureFocus()
					stopCollapsing()
					collapseExpandTerminal(true)
				elseif key == 'Tab' and commandText:match('%w') then
					local autocomplete
					for _,v in cmdList:GetChildren() do
						local name = v.Name
						if v:IsA('TextButton') and name ~= '' and name:match(commandText) then autocomplete = getCommandNames(name)[1] break end
					end
					barTextBox.Text = `{autocomplete} `
					barTextBox:CaptureFocus()
				elseif (key == 'Up' or key == 'Down') and isFocused then
					historyCount = (key == 'Up' and historyCount == 0) and #cmdHistory or (key == 'Up' and #cmdHistory > 1) and math.clamp(historyCount-1,1,#cmdHistory) or (key == 'Down' and historyCount ~= 0 and cmdHistory[historyCount+1]) and historyCount+1 or historyCount
					barTextBox.Text = cmdHistory[historyCount]
					barTextBox.CursorPosition = barTextBox.Text:len()+1
				end
			end
			UserInputService.InputBegan:Connect(onInputBegan)
		end
	end
	
	do -- hover terminal collapsing & expanding
		local function onMouseEnter()
			if not loaded then return end
			stopCollapsing()
			collapseExpandTerminal(true)
		end
		local function onMouseLeave()
			if barTextBox:IsFocused() or not loaded then return end
			collapsing = coroutine.create(function() -- task.delay(1,collapseExpandTerminal,false)
				wait(1)
				collapseExpandTerminal(false,200)
			end)
			coroutine.resume(collapsing)
		end
		terminal.MouseEnter:Connect(onMouseEnter)
		terminal.MouseLeave:Connect(onMouseLeave)
	end
	
	wait(1)
	Debris:AddItem(loading,.5)
	TweenService:Create(credits,TweenInfo.new(.2,'Quart','Out'),{Position = UDim2.new(.5,0,1,20)}):Play()
	TweenService:Create(loadingIcon,TweenInfo.new(.5,'Quart','Out'),{GroupTransparency=1}):Play()
	wait(.5)
	barTextBox.TextEditable = true
	collapseExpandTerminal(false,200)
	loaded = true
end

