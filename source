do
	local DISTANCE,MIN_DISTANCE,MAX_DISTANCE = 3,0,math.huge
	local DELAY,MIN_DELAY,MAX_DELAY = 0,0,math.huge
	local loop
	table.insert(COMMANDS,{
		['loopgoto [player] [distance] [delay]'] = {
			description = `Loop teleport to a player (min distance - {MIN_DISTANCE}, max - {MAX_DISTANCE})`,
			execute = function(text:string)
				local arguments = text:split(' ')
				local player = getPlayerArgument(arguments[1])[1]
				local character = player and player.Character
				local humanoid = player and getHumanoid(player)
				if not character or not humanoid or player == owner then return end
				DISTANCE = getNumberArgument(arguments[2],MIN_DISTANCE,MAX_DISTANCE) or DISTANCE
				DELAY = getNumberArgument(arguments[3],MIN_DELAY,MAX_DELAY) or DELAY
