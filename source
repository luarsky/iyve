do
	local enabled = false
	local hovers = {}
	local deleting
	table.insert(COMMANDS,{
		['guiremove'] = {
			description = "Enables backspace & delete to remove GUI elements, doesn't work with legacy custom 3D texts",
			execute = function()
				if enabled then notify('GUI Remove','GUI Remove is already enabled') return end
				enabled = true
				local function onInputBegan(input:InputObject,gameProcessedEvent)
					if gameProcessedEvent or (input.KeyCode ~= Enum.KeyCode.Backspace and input.KeyCode ~= Enum.KeyCode.Delete) then return end
					for i:Instance,v in hovers do
						local isIY do -- why no IsDescendantOf :(
							local lastParent:Instance?
							repeat
								wait()
								lastParent = lastParent and lastParent.Parent or i.Parent
								if lastParent == IY then isIY = true break end
							until lastParent == ownerGui
						end
						if not v.status or isIY then continue end
						v.enterConnection = killConnection(v.enterConnection)
						v.leaveConnection = killConnection(v.leaveConnection)
						i:Destroy()
						hovers[i] = nil
					end
				end
				deleting = UserInputService.InputBegan:Connect(onInputBegan)
				for _,v in ownerGui:GetDescendants() do
					if not v:IsA('TextLabel') and not v:IsA('Frame') and not v:IsA('ImageLabel') and not v:IsA('TextButton') then continue end -- And I know about "GuiObject" class, it's just Vortex sucks and doesn't support it
					hovers[v] = {status = false}
					local function onMouseEnter()
						hovers[v].status = true
					end
					local function onMouseLeave()
						hovers[v].status = false
					end
					hovers[v].enterConnection = v.MouseEnter:Connect(onMouseEnter)
					hovers[v].leaveConnection = v.MouseLeave:Connect(onMouseLeave)
				end
				notify('GUI Remove','Hover over a GUI element and press backspace or delete to remove it')
			end
		}
	})
	table.insert(COMMANDS,{
		['unguiremove / noguiremove'] = {
			description = 'Disables guiremove',
			execute = function()
				if not enabled then notify('GUI Remove',"GUI Remove isn't enabled") return end
				enabled = false
				if deleting then
					deleting = killConnection(deleting)
				end
				for _,v in hovers do
					v.enterConnection = killConnection(v.enterConnection)
					v.leaveConnection = killConnection(v.leaveConnection)
				end
				table.clear(hovers)
				notify('GUI Remove','GUI Remove has been disabled')
			end
		}
	})
end

