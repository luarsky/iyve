		local cmdsHeightOffset,listHeightOffset = cmds.Size.Y.Offset,cmdList.Size.Y.Offset
		scroller.Position = UDim2.fromOffset(0,0)
		scroller.Size = UDim2.fromOffset(8,listHeightOffset > cmdsHeightOffset and (cmdsHeightOffset/(listHeightOffset/cmdsHeightOffset)) or 0)
		stopScrolling()
	end
	local function showAvailableCommands()
		for _,v in cmdList:GetChildren() do
			if v:IsA('TextButton') then v.Visible = v.Name:match(barTextBox.Text) and true or false end
		end
		resize()
	end
	local function collapseExpandTerminal(status)
		TweenService:Create(terminal,TweenInfo.new(status and .2 or .5,'Quart','Out'),{Position=UDim2.new(1,inStudio and -20 or 0,1,status and 0 or 200)}):Play()
		if status then return end
		stopScrolling()
	end
	local availableTypingKeys,keyReplacements = {
		typing = {
			'a','b','c','d','e','f','g','h','i','j','k','l','m','n','o','p','q','r','s','t','u','v','w','x','y','z',
			'zero','one','two','three','four','five','six','seven','eight','nine',
			'space','period'
		},
		editing = {'backspace'},
		history = {'up','down'},
		autocomplete = {'tab'}
	},{
		zero=0,one=1,two=2,three=3,four=4,five=5,six=6,seven=7,eight=8,nine=9,
		space=' ',period='.'
	}
	local collapsing
	local function stopCollapsing()
		if not collapsing then return end
		collapsing = killThread(collapsing)
	end
	local oldMovement = {WalkSpeed=0,JumpPower=0}
	terminalBarTyping = false
	local typingConnection
	local function unFocus() -- text box unfocus behaviour
		if not terminalBarTyping then return end
		terminalBarTyping = false
		for i,v in oldMovement do
			ownerHumanoid[i] = v
		end
		if typingConnection then
			typingConnection = killConnection(typingConnection)
		end
		barTextBox.Text = ''
		showAvailableCommands()
		barTextBox.Text = `Command Bar ({PREFIX})`
		local collapse = coroutine.create(function() -- task.delay(.2,collapseExpandTerminal,false)
			wait(.2)
			collapseExpandTerminal(false)
		end)
		coroutine.resume(collapse)
	end
	local function focus() -- text box focus behaviour
		if terminalBarTyping or not loaded then return end
		terminalBarTyping = true
		for i in oldMovement do
			oldMovement[i] = ownerHumanoid[i]
			ownerHumanoid[i] = 0
		end
		stopCollapsing()
		barTextBox.Text = ''
		showAvailableCommands()
		collapseExpandTerminal(true)
		mouse.Button1Down:Once(unFocus)
		local function onInputBegan(input:InputObject,gameProcessedEvent) -- text box behaviour
			local key = input.KeyCode.Name:lower()
			local inputType
			for i,v in availableTypingKeys do
				if table.find(v,key) then inputType = i break end
			end
			if gameProcessedEvent or not inputType then return end
			local currentText = barTextBox.Text
			local autocomplete = ''
			for _,v in cmdList:GetChildren() do
				local name = v.Name
				if v:IsA('TextButton') and name ~= '' and name:match(currentText) then autocomplete = getCommandNames(name)[1] break end
			end
			historyCount = (inputType == 'history' and key == 'up' and historyCount == 0) and #cmdHistory or (inputType == 'history' and key == 'up' and #cmdHistory > 1) and math.clamp(historyCount-1,1,#cmdHistory) or (inputType == 'history' and key == 'down' and historyCount ~= 0 and cmdHistory[historyCount+1]) and historyCount+1 or historyCount
			barTextBox.Text = inputType == 'typing' and currentText..(keyReplacements[key] or key) or (inputType == 'editing' and key == 'backspace') and currentText:sub(1,currentText:len()-1) or inputType == 'autocomplete' and `{autocomplete} ` or inputType == 'history' and (cmdHistory[historyCount] or '') or currentText
			showAvailableCommands()	
		end
		typingConnection = UserInputService.InputBegan:Connect(onInputBegan)
	end
	bar.MouseButton1Click:Connect(focus)
	do -- start typing / execute
		local function onInputBegan(input:InputObject,gameProcessedEvent)
			if not loaded then return end
			local pressedKey = input.KeyCode
			if gameProcessedEvent or (pressedKey ~= Enum.KeyCode.Semicolon and pressedKey ~= Enum.KeyCode.Return) then return end
			if pressedKey == Enum.KeyCode.Semicolon then
				focus()
			else
				local barText = barTextBox.Text
				unFocus()
				execute(barText,true)
			end
		end
		UserInputService.InputBegan:Connect(onInputBegan)
	end
	local tip:Frame = createInstance('Frame',{Parent=tips,Name='Tip',Size=UDim2.fromOffset(200,96),BackgroundColor3=Color3.fromRGB(69,42,100),BackgroundTransparency=.1,Visible=false})
	local title:TextLabel = createInstance('TextLabel',{Parent=tip,Name='Title',Size=UDim2.new(1,0,0,20),BackgroundColor3=Color3.fromRGB(48,29,70),BackgroundTransparency=.1,TextColor3=Color3.fromRGB(255,255,255),TextSize=12,Font='Roboto'})
	local description:TextLabel = createInstance('TextLabel',{Parent=tip,Name='Description',AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,0,91),Size=UDim2.fromOffset(190,67),BackgroundTransparency=1,TextColor3=Color3.fromRGB(255,255,255),TextSize=13,TextWrapped=true,Font='Roboto'})
	for _,command in COMMANDS do -- load commands
		for name,data in command do
			local cmd:TextButton = createInstance('TextButton',{Parent=cmdList,Name=name,Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,Text=name,TextColor3=Color3.fromRGB(255,255,255),TextSize=14,TextXAlignment='Left',Font='Roboto'})
			resize()
			local function onMouseEnter()
				if not loaded then return end
				local noEmpty = name ~= ''
				tip.Visible = noEmpty
				if not noEmpty then return end
				title.Text = name
				description.Text = data.description
			end
			local function onMouseButton1Click()
				if not loaded then return end
				focus()
				barTextBox.Text = `{getCommandNames(cmd.Text)[1]} `
				showAvailableCommands()
			end
			cmd.MouseEnter:Connect(onMouseEnter)
			cmd.MouseButton1Click:Connect(onMouseButton1Click)
		end
	end
	do -- hover tips
		local mouseTipMoving
		local function getTipPlacement()
			local mouseY = mouse.Y
			return mouse.ViewSizeY-mouseY > 140 and Vector2.xAxis or Vector2.one,UDim2.fromOffset(mouse.X,mouseY)
		end
		local function onMouseEnter()
			if not loaded then return end
			local showAnchorPoint,showPosition = getTipPlacement()
			tip.AnchorPoint = showAnchorPoint
			tip.Position = showPosition
			tip.Visible = true
			local function onMove()
				local updateAnchorPoint,updatePosition = getTipPlacement()
				tip.AnchorPoint = updateAnchorPoint
				tip.Position = updatePosition
			end
			mouseTipMoving = mouse.Move:Connect(onMove)
		end
		local function onMouseLeave()
			if not loaded then return end
			tip.Visible = false
			if not mouseTipMoving then return end
			mouseTipMoving = killConnection(mouseTipMoving)
		end
		cmdList.MouseEnter:Connect(onMouseEnter)
		cmdList.MouseLeave:Connect(onMouseLeave)
	end
	do -- cmd list scrolling
		local mouseScrollMoving
		local SCROLL_SPEED = 50
		local function onMouseButton1Down()
			if scroller.Size.Y.Offset == 0 or not loaded then return end
			local scrollerFrameHeight = scrollerFrame.Size.Y.Offset
			local scrollDirection,lastScrollDirection
			local function updateScrollDirection()
				scrollDirection = mouse.Y > mouse.ViewSizeY-scrollerFrameHeight/2 and 'down' or 'up'
			end
			updateScrollDirection()
			lastScrollDirection = scrollDirection
			local function scrolling()
				local scrollerGoal = scrollDirection == 'down' and scrollerFrameHeight-scroller.Size.Y.Offset or 0
				local startScrollerPositionY = scroller.Position.Y.Offset
				if startScrollerPositionY == scrollerGoal then return end
				local scrollTime = math.abs(scrollerGoal-startScrollerPositionY)/SCROLL_SPEED
				local scrollerTween = TweenService:Create(scroller,TweenInfo.new(scrollTime,'Linear'),{Position=UDim2.fromOffset(0,scrollerGoal)})
				table.insert(tweens,scrollerTween)
				scrollerTween:Play()
				local listGoal = scrollDirection == 'down' and -cmdList.Size.Y.Offset or 0
				local listTween = TweenService:Create(cmdList,TweenInfo.new(scrollTime,'Linear'),{Position=UDim2.fromOffset(5,listGoal)})
				table.insert(tweens,listTween)
				listTween:Play()
			end
			scrolling()
			local function onMove()
				updateScrollDirection()
				if scrollDirection == lastScrollDirection then return end
				lastScrollDirection = scrollDirection
				stopScrolling()
				scrolling()
			end
			mouseScrollMoving = mouse.Move:Connect(onMove)
		end
		local function onMouseButton1Up()
			if not loaded then return end
			if mouseScrollMoving then
				mouseScrollMoving = killConnection(mouseScrollMoving)
			end
			stopScrolling()
		end
		scrollerFrame.MouseButton1Down:Connect(onMouseButton1Down)
		scrollerFrame.MouseButton1Up:Connect(onMouseButton1Up)
	end
	do -- hover terminal collapsing & expanding
		local function onMouseEnter()
			if not loaded then return end
			stopCollapsing()
			collapseExpandTerminal(true)
		end
		local function onMouseLeave()
			if terminalBarTyping or not loaded then return end
			collapsing = coroutine.create(function() -- task.delay(1,collapseExpandTerminal,false)
				wait(1)
				collapseExpandTerminal(false)
			end)
			coroutine.resume(collapsing)
		end
		terminal.MouseEnter:Connect(onMouseEnter)
		terminal.MouseLeave:Connect(onMouseLeave)
	end
	wait(1)
	Debris:AddItem(loading,.5)
	TweenService:Create(credits,TweenInfo.new(.2,'Quart','Out'),{Position = UDim2.new(.5,0,1,20)}):Play()
	TweenService:Create(loading,TweenInfo.new(.5,'Size','Out'),{BackgroundTransparency = 1}):Play()
	TweenService:Create(iconLogo,TweenInfo.new(.5,'Size','Out'),{ImageTransparency=1}):Play()
	TweenService:Create(iconLabel,TweenInfo.new(.5,'Size','Out'),{TextTransparency=1}):Play()
	TweenService:Create(iconLabelStroke,TweenInfo.new(.5,'Size','Out'),{Transparency=1}):Play()
	wait(.5)
	collapseExpandTerminal(false)
	loaded = true
end

